<Project Sdk="Dalamud.NET.Sdk/15.0.0">

	<PropertyGroup>
		<Name>AoAoEnergy</Name>
		<Author>Loskh</Author>
		<Punchline>将强化药（爆发药）特效替换为充满活力的 RGB 能量光效。</Punchline>
		<Description>使用强化药（爆发药）时，为角色播放嗷嗷有劲的 RGB 能量光效。支持六档垂直位置调节、无需消耗爆发药的即时预览、一键清除当前光效，并可按角色分别记住高度设置。原作者：Loskh。本版本为私人修复版本。</Description>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<Version>1.0.4.2</Version>
		<IncludeSymbols>False</IncludeSymbols>
        <ApplicableVersion>2026.09.01.0000.0000</ApplicableVersion>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Penumbra.String\Penumbra.String.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Include="ev_energydrink_01x_30s*.avfx">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
